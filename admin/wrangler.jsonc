{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio-admin",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-17",
  // no account_id here: wrangler takes it from `wrangler login`
  "ai": { "binding": "AI" },
  // same database as ../worker/wrangler.jsonc. PLACEHOLDER id: paste the one `wrangler d1 create portfolio-qa` prints.
  "d1_databases": [
    { "binding": "DB", "database_name": "portfolio-qa", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "../db/migrations" }
  ],
  "vars": {
    "TEXT_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    // Cloudflare Access is the login. Every request without a Cf-Access-Jwt-Assertion header is rejected unless this is
    // "false" (local dev only: put REQUIRE_ACCESS=false in admin/.dev.vars, which is gitignored).
    "REQUIRE_ACCESS": "true",
    // Fill in after creating the Access application, to also verify the JWT signature (see ../worker/README.md).
    // Team domain looks like "yourteam.cloudflareaccess.com"; AUD is the application's "Application Audience (AUD) Tag".
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  }
}
