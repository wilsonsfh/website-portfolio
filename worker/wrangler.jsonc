{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-17",
  // no account_id here: wrangler takes it from `wrangler login`
  "ai": { "binding": "AI" },
  // the built site (run `npm run build` in the repo root first); only /api/* and /admin* reach the worker code
  "assets": { "directory": "../dist", "run_worker_first": ["/api/*", "/admin*"] },
  // knowledge.md is bundled as a text module
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  // D1 holds the unanswered questions and Wilson's answers. Create it once with `wrangler d1 create portfolio-qa`,
  // then put the printed id here (ids are not secret).
  "d1_databases": [
    { "binding": "DB", "database_name": "portfolio-qa", "database_id": "1ee9f5bc-9ac1-45bb-b4f4-cf64cc11bbe8", "migrations_dir": "../db/migrations" }
  ],
  // Rate Limiting binding (needs wrangler >= 4.36). period must be 10 or 60.
  "ratelimits": [
    { "name": "RL_CHAT", "namespace_id": "7101", "simple": { "limit": 8, "period": 60 } },
    { "name": "RL_IMAGE", "namespace_id": "7102", "simple": { "limit": 1, "period": 60 } }
  ],
  "vars": {
    // comma-separated list of exact origins allowed by CORS
    "ALLOWED_ORIGINS": "https://portfolio.wilsonsoon.workers.dev,http://localhost:4321,http://localhost:5173,http://localhost:4173",
    "TEXT_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "IMAGE_MODEL": "@cf/black-forest-labs/flux-1-schnell",
    "GROQ_MODEL": "openai/gpt-oss-20b"
  }
  // ADMIN_TOKEN (the /admin password) is a secret too: `wrangler secret put ADMIN_TOKEN`
  // GROQ_API_KEY is a secret: `wrangler secret put GROQ_API_KEY` (never put it here)
}
