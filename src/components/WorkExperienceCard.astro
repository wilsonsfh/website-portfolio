---
interface Props {
  company: string;
  logo?: string;
  website?: string;
  role: string;
  date: string;
  location?: string;
  description: string[];
  tags: string[];
}

const { company, logo, website, role, date, location, description, tags } = Astro.props;
---

<div class="bg-background dark:bg-background-dark rounded-xl p-6 border border-foreground/5 dark:border-foreground-dark/10 border-l-[3px] border-l-accent dark:border-l-accent-dark hover:-translate-y-1 hover:shadow-xl transition-all duration-300">
  <div class="flex flex-col gap-4 sm:grid sm:grid-cols-[minmax(0,1fr)_7rem] sm:items-start">
    <div class="min-w-0">
      <div class="mb-3">
        <div class="flex items-baseline justify-between gap-4 whitespace-nowrap">
          <h3 class="font-heading font-semibold text-lg text-foreground dark:text-foreground-dark truncate">{role}</h3>
          <div class="text-foreground-muted dark:text-foreground-dark-muted text-sm font-mono whitespace-nowrap flex-shrink-0">{date}</div>
        </div>
        <div class="flex items-baseline justify-between gap-4 whitespace-nowrap">
          {website ? (
            <a
              href={website}
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent dark:text-accent-dark font-medium hover:underline truncate"
            >
              {company}
            </a>
          ) : (
            <p class="text-accent dark:text-accent-dark font-medium truncate">{company}</p>
          )}
          {location && (
            <div class="text-foreground-muted dark:text-foreground-dark-muted text-sm whitespace-nowrap flex-shrink-0">
              {location}
            </div>
          )}
        </div>
      </div>
      <ul class="list-disc pl-5 text-foreground-muted dark:text-foreground-dark-muted space-y-1.5 mb-4 text-sm">
        {description.map((item) => <li>{item}</li>)}
      </ul>
      <div class="flex flex-wrap gap-2">
        {tags.map((tag) => (
          <span class="text-xs font-mono px-2.5 py-1 rounded-full border border-accent/20 dark:border-accent-dark/20 bg-accent/5 dark:bg-accent-dark/10 text-accent dark:text-accent-dark">
            {tag}
          </span>
        ))}
      </div>
    </div>
    <div class="flex flex-col gap-2 sm:items-end sm:text-right">
      {logo && (
        website ? (
          <a
            href={website}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Visit ${company} website`}
            class="w-20 h-12 flex items-center justify-end rounded-md p-1 dark:bg-white"
          >
            <img
              src={logo}
              alt={`${company} logo`}
              class="max-w-full max-h-full object-contain opacity-80 dark:opacity-90"
              loading="lazy"
            />
          </a>
        ) : (
          <div class="w-20 h-12 flex items-center justify-end rounded-md p-1 dark:bg-white">
            <img
              src={logo}
              alt={`${company} logo`}
              class="max-w-full max-h-full object-contain opacity-80 dark:opacity-90"
              loading="lazy"
            />
          </div>
        )
      )}
    </div>
  </div>
</div>
