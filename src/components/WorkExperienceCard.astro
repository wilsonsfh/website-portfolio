---
interface Props {
  company: string;
  logo?: string;
  role: string;
  date: string;
  description: string[];
  tags: string[];
}

const { company, logo, role, date, description, tags } = Astro.props;
---

<div class="bg-background dark:bg-background-dark rounded-xl p-6 border border-foreground/5 dark:border-foreground-dark/10 border-l-[3px] border-l-accent dark:border-l-accent-dark hover:-translate-y-1 hover:shadow-xl transition-all duration-300">
  <div class="flex items-start justify-between gap-4 mb-3">
    <div class="flex-1 min-w-0">
      <h3 class="font-heading font-semibold text-lg text-foreground dark:text-foreground-dark">{role}</h3>
      <p class="text-accent dark:text-accent-dark font-medium">{company}</p>
      <span class="text-foreground-muted dark:text-foreground-dark-muted text-sm mt-1 font-mono block">{date}</span>
    </div>
    {logo && (
      <div class="flex-shrink-0 w-20 h-12 flex items-center justify-end rounded-md p-1 dark:bg-white">
        <img
          src={logo}
          alt={`${company} logo`}
          class="max-w-full max-h-full object-contain opacity-80 dark:opacity-90"
          loading="lazy"
        />
      </div>
    )}
  </div>
  <ul class="list-disc list-inside text-foreground-muted dark:text-foreground-dark-muted space-y-1.5 mb-4 text-sm">
    {description.map((item) => <li>{item}</li>)}
  </ul>
  <div class="flex flex-wrap gap-2">
    {tags.map((tag) => (
      <span class="text-xs font-mono px-2.5 py-1 rounded-full border border-accent/20 dark:border-accent-dark/20 bg-accent/5 dark:bg-accent-dark/10 text-accent dark:text-accent-dark">
        {tag}
      </span>
    ))}
  </div>
</div>
