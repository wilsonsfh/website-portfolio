---
import workExperience from "../data/work-experience.json";
import projects from "../data/projects.json";
import activities from "../data/activities.json";
import skills from "../data/skills.json";

const skillLine = Object.values(skills).flat().join(", ").toLowerCase();

const contacts = [
  { label: "email", href: "mailto:wilionsoon2010@gmail.com", text: "wilionsoon2010@gmail.com" },
  { label: "github", href: "https://github.com/wilsonsfh", text: "wilsonsfh" },
  { label: "x", href: "https://x.com/wilsonsfh_", text: "wilsonsfh_" },
  { label: "linkedin", href: "https://linkedin.com/in/wilsonsfh", text: "wilsonsfh" },
];

const rows = ["about", "work", "projects", "activities", "get in touch"].map((label) => ({
  label,
  id: label.replace(/\s+/g, "-"),
}));
const ext = (href: string) =>
  href.startsWith("mailto") ? {} : { target: "_blank", rel: "noopener noreferrer" };
---

<main id="main" class="page">
  <div class="column">
    <header class="intro">
      <h1 class="name">wilson.</h1>
      <p class="lede">
        based in singapore, studying computer science at the national university of singapore and passionate about building all things tech and aesthetics.
      </p>
    </header>

    <div class="rows">
      {rows.map(({ label, id }) => (
        <section class="row">
          <h2 class="row-heading">
            <button type="button" class="row-btn" aria-expanded="false" aria-controls={`panel-${id}`} id={`btn-${id}`}>
              <span class="row-label">{label}</span>
              <svg class="chev" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 5.5l4 4 4-4" />
              </svg>
            </button>
          </h2>
          <div class="panel" id={`panel-${id}`} role="region" aria-labelledby={`btn-${id}`}>
            <div class="panel-clip">
              <div class="panel-body">
                {label === "about" && (
                  <>
                    <p>i'm currently thinking about how to be a better individual contributor as a software engineer with AI. i'm also interested in product thinking and building something people want, and learning how to ace prioritisations of a hundred things.</p>
                    <p>in my free time, i like exploring tea brands, freestyle dancing and doing photography. i am also currently learning the guitar, rock climbing and volleyball. these build my own unique story, which i believe the best software is built by people who bring diverse perspectives to the table.</p>
                    <p class="meta">skills: {skillLine}</p>
                  </>
                )}
                {label === "work" && workExperience.map((job) => (
                  <article class="item">
                    <p class="item-head">
                      <a href={job.website} {...ext(job.website)}>{job.company}</a>
                      <span class="sep">/</span>{job.role}
                      <span class="meta date">{job.date}</span>
                    </p>
                    {job.description.map((d) => <p class="meta">{d}</p>)}
                  </article>
                ))}
                {label === "projects" && projects.map((p) => (
                  <article class="item">
                    <p class="item-head">
                      {p.title}
                      <span class="links">
                        {p.github && <a href={p.github} {...ext(p.github)}>github</a>}
                        {p.live && <a href={p.live} {...ext(p.live)}>live</a>}
                      </span>
                    </p>
                    <p class="desc">{p.description}</p>
                    <p class="meta">{p.tags.join(", ")}</p>
                  </article>
                ))}
                {label === "activities" && activities.map((a) => (
                  <article class="item">
                    <p class="item-head">
                      {a.title}
                      {a.role && <><span class="sep">/</span>{a.role}</>}
                      {a.date && <span class="meta date">{a.date}</span>}
                    </p>
                    {a.descriptions.map((d) => <p class="meta">{d}</p>)}
                  </article>
                ))}
                {label === "get in touch" && (
                  <ul class="contacts">
                    {contacts.map((c) => (
                      <li><span class="meta">{c.label}</span><a href={c.href} {...ext(c.href)}>{c.text}</a></li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          </div>
        </section>
      ))}
    </div>

    <footer class="foot">
      <span class="meta">wilson soon, 2026</span>
      <button type="button" class="foot-btn" id="theme-toggle" aria-label="switch to dark theme">dark</button>
    </footer>
  </div>
</main>

<script>
  document.querySelectorAll<HTMLButtonElement>(".row-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const open = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!open));
    });
  });

  const toggle = document.getElementById("theme-toggle");
  const root = document.documentElement;
  const sync = () => {
    const dark = root.classList.contains("dark");
    if (toggle) {
      toggle.textContent = dark ? "light" : "dark";
      toggle.setAttribute("aria-label", dark ? "switch to light theme" : "switch to dark theme");
    }
  };
  sync();
  toggle?.addEventListener("click", () => {
    const dark = root.classList.toggle("dark");
    try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch {}
    sync();
  });
</script>

<style is:global>
  .page { min-height: 100vh; min-height: 100dvh; }
  .column { max-width: 620px; margin: 0 auto; padding: 96px 24px 64px; text-align: left; }
  @media (min-width: 768px) { .column { padding-top: 192px; } }

  .name { font-size: 44px; line-height: 1.05; font-weight: 500; letter-spacing: -0.03em; text-transform: lowercase; }
  .lede { margin-top: 20px; font-size: 17px; line-height: 1.65; max-width: 34em; }
  .intro { margin-bottom: 96px; }

  .meta { font-size: 14px; line-height: 1.6; color: var(--muted); }
  .row { border-top: 1px solid var(--line); }
  .row:last-child { border-bottom: 1px solid var(--line); }
  .row-heading { font-size: inherit; font-weight: inherit; text-transform: none; }
  .row-btn {
    display: flex; align-items: center; justify-content: space-between; width: 100%;
    min-height: 52px; padding: 0; background: none; border: 0; color: inherit; cursor: pointer;
    font: inherit; font-size: 17px; font-weight: 400; text-align: left; text-transform: lowercase;
    border-radius: 4px;
  }
  .chev { color: var(--muted); transition: transform 200ms cubic-bezier(0.23, 1, 0.32, 1); }
  .row-btn[aria-expanded="true"] .chev { transform: rotate(180deg); }
  .row-btn:focus-visible, .foot-btn:focus-visible, .column a:focus-visible {
    outline: 2px solid var(--accent); outline-offset: 2px;
  }

  /* expand: grid rows 0fr -> 1fr; closing is slightly faster than opening */
  .panel {
    display: grid; grid-template-rows: 0fr; opacity: 0; visibility: hidden;
    transition:
      grid-template-rows 160ms cubic-bezier(0.23, 1, 0.32, 1),
      opacity 160ms cubic-bezier(0.23, 1, 0.32, 1),
      visibility 0s linear 160ms;
  }
  .row:has(> h2 > [aria-expanded="true"]) .panel {
    grid-template-rows: 1fr; opacity: 1; visibility: visible;
    transition:
      grid-template-rows 220ms cubic-bezier(0.23, 1, 0.32, 1),
      opacity 220ms cubic-bezier(0.23, 1, 0.32, 1),
      visibility 0s;
  }
  .panel-clip { overflow: hidden; min-height: 0; }
  .panel-body { padding: 4px 0 32px; display: flex; flex-direction: column; gap: 14px; font-size: 16px; line-height: 1.65; }
  .panel-body > p:not(.meta) { max-width: 34em; }

  .item { display: flex; flex-direction: column; gap: 4px; margin-bottom: 18px; }
  .item:last-child { margin-bottom: 0; }
  .item-head { font-size: 16px; line-height: 1.5; font-weight: 500; }
  .item-head .sep { margin: 0 6px; color: var(--muted); font-weight: 400; }
  .item-head .date { margin-left: 8px; font-weight: 400; white-space: nowrap; }
  .item-head .links { margin-left: 10px; font-weight: 400; font-size: 14px; display: inline-flex; gap: 10px; }
  .desc { font-size: 15px; line-height: 1.55; }

  .column a { color: inherit; text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 3px; border-radius: 2px; }
  @media (hover: hover) and (pointer: fine) {
    .column a:hover { color: var(--accent); text-decoration-color: currentColor; }
    .row-btn:hover .chev, .foot-btn:hover { color: var(--fg); }
  }

  .contacts { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .contacts li { display: grid; grid-template-columns: 72px 1fr; align-items: baseline; font-size: 16px; overflow-wrap: anywhere; }

  .foot { margin-top: 64px; display: flex; justify-content: space-between; align-items: center; }
  .foot-btn {
    background: none; border: 0; padding: 12px 0 12px 12px; min-height: 44px; cursor: pointer;
    font: inherit; font-size: 14px; color: var(--muted); text-transform: lowercase; border-radius: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .panel, .row:has(> h2 > [aria-expanded="true"]) .panel { transition: opacity 160ms ease-out, visibility 0s linear 160ms; }
    .row:has(> h2 > [aria-expanded="true"]) .panel { transition: opacity 160ms ease-out, visibility 0s; }
    .chev { transition: none; }
  }
</style>
